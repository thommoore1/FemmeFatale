    name: Assets/FemmeFatale/Scenarios/FemmeFatale.xls:Start
    type: 1
    textLength: 430
    headerRow: 0
    sourceAssetInEditor: {fileID: 102900000, guid: 5edbe1e9889507740a86b18eaf060779, type: 3}
    entityIndexTbl: 
    entityDataList: []
  - rows:
    - rowIndex: 0
