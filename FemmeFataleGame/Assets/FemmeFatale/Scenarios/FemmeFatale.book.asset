    - rowIndex: 12
      debugIndex: 13
      strings:
      - 
      - Eyeris
      - 
      - 
      - 
      - 
      - 
      - 
      - Put that thing away, you wretch!
      isEmpty: 0
      isCommentOut: 0
      debugInfo: 
    - rowIndex: 13
      debugIndex: 14
      strings:
      - 
      - Eyeris
      - 
      - 
      - 
      - 
      - 
      - 
      - "Be a gentleman now, don\u2019t hurt this lady\u2019s eyes. You\u2019ll give me a headache."
      isEmpty: 0
      isCommentOut: 0
      debugInfo: 
    - rowIndex: 14
      debugIndex: 15
      strings:
      - 
      - 
      - 
      - 
      - 
      - 
      - 
      - 
      - "A woman who drowns herself in booze until she\u2019s hungover till the next night. I\u2019ve found myself in many a bind like that, too."
      isEmpty: 0
      isCommentOut: 0
      debugInfo: 
