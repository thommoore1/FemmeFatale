      - '*LookingIsNoCrime'
      isEmpty: 0
      isCommentOut: 0
      debugInfo: 
    - rowIndex: 7
      debugIndex: 8
      strings:
      - 
      - Eyeris
      - 
      - 
      - 
      - 
      - 
      - 
      - 'How cooperative, for such a little human! '
      isEmpty: 0
      isCommentOut: 0
      debugInfo: 
    - rowIndex: 8
      debugIndex: 9
      strings:
      - 
      - Eyeris
      - 
      - 
      - 
      - 
      - 
      - 
      - "You know, why don\u2019t I have you for dinner?"
      isEmpty: 0
      isCommentOut: 0
      debugInfo: 
    - rowIndex: 9
      debugIndex: 10
      strings:
      - 
      - 
      - 
      - 
      - 
      - 
      - 
      - 
      - "I get the feeling she\u2019s talking about some steak. She\u2019s got good taste."
      isEmpty: 0
